{
  "name": "mithril-markdown-wysiwyg",
  "version": "0.4.0",
  "description": "A powerful WYSIWYG markdown editor for Mithril.js with dual-mode editing, theme support, and extensive formatting options",
  "keywords": [
    "mithril",
    "markdown",
    "wysiwyg",
    "editor",
    "typescript",
    "rich-text",
    "text-editor"
  ],
  "author": "Erik Vullings",
  "license": "MIT",
  "homepage": "https://github.com/erikvullings/mithril-markdown-wysiwyg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikvullings/mithril-markdown-wysiwyg.git"
  },
  "bugs": {
    "url": "https://github.com/erikvullings/mithril-markdown-wysiwyg/issues"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "browser": "dist/index.umd.js",
  "unpkg": "dist/index.umd.min.js",
  "jsdelivr": "dist/index.umd.min.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "browser": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/index.css": "./dist/index.css",
    "./css": "./dist/index.css",
    "./style.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm build:types && pnpm build:bundle && pnpm build:bundle:min",
    "build:bundle": "vite build --mode bundle",
    "build:bundle:min": "vite build --mode umd-min",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:watch": "vite build --mode bundle --watch",
    "dev": "pnpm build:watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "mithril": "^2.3.8"
  },
  "dependencies": {
    "slimdown-js": "^1.5.4"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/mithril": "2.2.9",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "mithril": "^2.3.8",
    "semantic-release": "^25.0.9",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}